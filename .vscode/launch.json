{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Image Describe (Linux) [module]",
      "type": "python",
      "request": "launch",
      "module": "src.image_description.cli.image_cli",
      "args": [
        "describe",
        "/home/junwin/nucshare/2025/Brisbane/Output/web",
        "--preset",
        "orwell_ways_of_seeing"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "CREDENTIAL_PATH": "/home/junwin/credential"
      }
    },
    {
      "name": "Python: Image Embed (Linux) [module]",
      "type": "python",
      "request": "launch",
      "module": "src.image_description.cli.image_cli",
      "args": [
        "embed",
        "/home/junwin/nucshare/2025/Brisbane/Output/web"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "CREDENTIAL_PATH": "/home/junwin/credential"
      }
    },
    {
